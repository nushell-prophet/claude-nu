# What claude-nu believes about Claude Code's transcript format.
#
# `drift.nu` compares this against the newest sessions on disk. Every entry is
# one line a human can flip, and the `note` is the reason it was flipped.
#
# status:
#   handled — a claude-nu reader consumes it. Absent from the window => `dead`:
#             the reader has nothing left to read, so delete it.
#   ignored — deliberately not read, with a reason in the note.
#   rare    — real, but too infrequent to expect in a 40-session window.
#             Exempt from the dead check.
#   todo    — seen in the transcripts, not yet triaged. Always reported.
#
# Baseline taken 2026-08-17 against Claude Code 2.1.233.
{
    record_types: {
        user: {status: handled note: "dialogue — messages, export-session, every user_msg_* metric"}
        assistant: {status: handled note: "dialogue, token usage, tool calls"}
        ai-title: {status: handled note: "extract-summary reads the last one as the session summary"}
        summary: {status: rare note: "legacy summary record; 2.1.x writes ai-title instead, but old sessions still carry it and extract-summary prefers it"}
        custom-title: {status: handled note: "the name `claude --name` writes, and what `gi open` sets to the canvas path. extract-summary prefers it over summary and ai-title: a human chose it"}
        attachment: {status: ignored note: "context Claude Code attaches to a turn, never a turn itself — so no dialogue command reads it. Subtypes seen in the newest 80 sessions, most first: total_tokens_reminder, output_style, deferred_tools_delta, skill_listing, mcp_instructions_delta, agent_listing_delta, edited_text_file, command_permissions, task_reminder, file, agent_mention, nested_memory, directory, hook_system_message, queued_command, hook_blocking_error, date_change. The file-ish ones look like user content but are not typed text: when the user writes @file.txt, the message already carries the mention (that is what mentioned_files reads) and the attachment carries the file's whole body. Folding that into messages or export-session would put text no human wrote into the record of what the human said, and would bloat every export by the size of the files read"}
        system: {status: ignored note: "Claude Code's own notices, not dialogue"}
        mode: {status: ignored note: "output-style / mode switches"}
        permission-mode: {status: ignored note: "permission mode switches"}
        last-prompt: {status: ignored note: "pointer to the last prompt; the user record already holds the text"}
        file-history-snapshot: {status: ignored note: "editor undo state"}
        file-history-delta: {status: ignored note: "editor undo state"}
        queue-operation: {status: ignored note: "queued-prompt bookkeeping"}
        agent-name: {status: ignored note: "display name of a background agent"}
        relocated: {status: ignored note: "records a cwd move; project-move rewrites cwd itself and does not read this"}
        atis-latch: {status: ignored note: "session heartbeat/latch record with an atis field; empty in every occurrence checked (1446 machine-wide) — an unpopulated feature-flag channel, not dialogue"}
        worktree-state: {status: ignored note: "EnterWorktree/ExitWorktree bookkeeping (originalCwd, worktreePath, worktreeName); editor state, not dialogue"}
        fork-context-ref: {status: ignored note: "written into the parent's transcript when Agent(subagent_type: fork) spawns a child — agentId, parentSessionId, parentLastUuid, contextLength, the point the fork branched off. Bookkeeping, not dialogue"}
        cost-state: {status: ignored note: "a running cost snapshot for the session (2.1.250+): totalCostUSD, totalAPIDuration, totalToolDuration, totalDuration, totalLinesAdded/Removed, and modelUsage keyed by model id. A session may hold several; the last one is current. Not read: token_usage already carries the cost/effort signal from message.usage, and totalCostUSD is 0 with an empty modelUsage in half a 40-session window — a snapshot written before any billed call, so it is not a signal every session has. modelUsage is where real dollars per model live if a cost column is ever wanted"}
        bridge-session: {status: ignored note: "cloud-bridge bookkeeping written when a session is bridged to a remote one (2.1.250+): bridgeSessionId (cse_*), lastSequenceNum, ownerAccountUuid, ownerOrganizationUuid. Plumbing, not dialogue"}
        api-request: {status: ignored note: "a log of one API call (first seen 2026-10-14, 2.1.30x): querySource, shapeHash, params with model, betas and effort. One per call, in subagent transcripts too. Not dialogue: the assistant record already carries the model and usage. The type is not user or assistant, so no reader picks it up"}
        api-request-blob: {status: ignored note: "one content-addressed piece of an API request (by `hash`, first seen 2026-10-14): a message with role user or system holding the system prompt, the CLAUDE.md text, deferred-tool lists. Text nobody typed, so it must never reach messages — and it does not, because readers key on `type`, not on `message.role`. It holds tool definitions, so `\"name\":\"Bash\"` occurs in it: the rg pre-filter of `tool-calls --tool` now passes every new file, which costs speed, not correctness. 40 of these were 200 KB of a 1.1 MB transcript on 2026-10-19"}
        api-request-shape: {status: ignored note: "the request skeleton a shapeHash names (first seen 2026-10-14): the system blocks and tool list of a session or a subagent. Same reasons as api-request-blob"}
        progress: {status: ignored note: "hook and tool progress events (data.type hook_progress and others). Old versions only: the newest is from 2.1.83, 2026-03-28"}
        dev-mods: {status: ignored note: "names the dev-mods folder of a session (~/.claude/dev-mods/<session>); plugin plumbing"}
        frame-link: {status: ignored note: "artifactCount and a timestamp, written when a session publishes artifacts; no dialogue"}
        continued-in: {status: ignored note: "continuedInSessionId: the session that took this one over. 1 record on disk on 2026-10-19. A reader that joins a session to its continuation would start here"}
    }

    content_blocks: {
        text: {status: handled note: "render-block"}
        thinking: {status: handled note: "render-block --thinking"}
        tool_use: {status: handled note: "render-block --tools, plus every tool metric"}
        tool_result: {status: handled note: "render-block --tools, tool_errors"}
        server_tool_use: {status: ignored note: "server-side tool call (advisor). render-block returns '' — correct here, the paired result is encrypted"}
        advisor_tool_result: {status: ignored note: "content is advisor_redacted_result with encrypted_content; there is nothing to render"}
        tool_addition: {status: ignored note: "a tool_reference added mid-conversation (the advisor tool, for one). Only inside api-request-blob records: 295 of 295 on disk on 2026-10-19"}
        fallback: {status: ignored note: "an assistant block naming a model fallback (from claude-fable-5 to claude-opus-5); nothing to render. Old versions only: 5 on disk, the newest from 2.1.220"}
        document: {status: ignored note: "a PDF the user attached, as base64 in a user record. Not typed text, like the body of an @file, so render-block drops it. 1 on disk on 2026-10-19, from 2.1.170"}
    }

    tool_names: {
        Bash: {status: handled note: "bash_commands, bash_count"}
        Edit: {status: handled note: "edited_files"}
        Write: {status: handled note: "edited_files"}
        Read: {status: handled note: "read_files"}
        Agent: {status: handled note: "extract-agents"}
        Skill: {status: handled note: "skill_invocations"}
        AskUserQuestion: {status: rare note: "ask_user_count — the reader is live, the tool is just infrequent: counted on 2026-09-01 over the newest sessions, 0 calls in a 40-file window, 2 in 150, 10 in 300. A default-window run therefore reports it dead. Same pair as EnterPlanMode/plan_mode_used. Re-check at --window 300 before believing it died"}
        EnterPlanMode: {status: rare note: "plan_mode_used — only present when the session used plan mode"}
        ToolSearch: {status: handled note: "tool_counts"}
        Monitor: {status: rare note: "tool_counts — long-running sessions only"}
        TaskCreate: {status: rare note: "tool_counts"}
        TaskUpdate: {status: rare note: "tool_counts"}
        TaskStop: {status: rare note: "tool_counts"}
        SendMessage: {status: ignored note: "agent-to-agent messaging; no metric asks for it, and tool_call_count counts it generically"}
        WebFetch: {status: ignored note: "no metric asks for it; tool_call_count counts it generically"}
        WebSearch: {status: ignored note: "no metric asks for it; tool_call_count counts it generically"}
        "mcp__*": {status: ignored note: "every MCP tool, collapsed to one class by observe. The real names are mcp__<server>__<tool> and depend on which servers the user connected, so listing them one by one would never settle"}
        ListAgents: {status: ignored note: "lists reachable agents/sessions; no metric asks for it, and tool_call_count counts it generically"}
        Workflow: {status: ignored note: "spawns a background multi-agent workflow; no metric asks for it, and tool_call_count counts it generically"}
        SendFeedback: {status: ignored note: "drafts Claude Code feedback, queued locally for the user to approve; no metric asks for it, and tool_call_count counts it generically. 1 call in the newest 300 session files on 2026-09-01"}
        StructuredOutput: {status: ignored note: "the tool a Workflow subagent given a `schema` calls to return its answer; no metric asks for it, and tool_call_count counts it generically. Lives only in Workflow subagent transcripts (agent-*.jsonl), exactly one call each because the agent prompt demands one: on 2026-09-22 at --window 120, 34 calls, all in agent-*.jsonl, none in a top-level session"}
        ScheduleWakeup: {status: rare note: "self-paced /loop: schedules the next wakeup of the session; no metric asks for it, and tool_call_count counts it generically. Only in /loop sessions: 1 call in the newest 40 files on 2026-10-07 (claude 2.1.292)"}
        Grep: {status: ignored note: "no metric asks for it; tool_counts and tool_call_count count it generically. Still in the tool lists of some subagents (nushell-reviewer, quote-digger); 730 calls on disk on 2026-10-19"}
        Glob: {status: ignored note: "same as Grep: 277 calls on disk on 2026-10-19"}
        ExitPlanMode: {status: ignored note: "no metric asks for it: plan_mode_used reads EnterPlanMode"}
        EnterWorktree: {status: ignored note: "no metric asks for it; tool_counts counts it. The worktree-state record holds the paths"}
        ExitWorktree: {status: ignored note: "same as EnterWorktree"}
        TaskList: {status: ignored note: "TODO-list read, like TaskCreate; no metric asks for it, tool_counts counts it"}
        TaskOutput: {status: ignored note: "reads the output of a background task; no metric asks for it, tool_counts counts it"}
        Artifact: {status: ignored note: "publishes a page; no metric asks for it, tool_counts counts it"}
        ReportFindings: {status: ignored note: "the typed findings list of /code-review; no metric asks for it, tool_counts counts it"}
        SubagentHandback: {status: ignored note: "a subagent handing control back; no metric asks for it, tool_counts counts it. 1 call on disk on 2026-10-19"}
    }

    usage_fields: {
        input_tokens: {status: handled note: "extract-token-usage"}
        output_tokens: {status: handled note: "extract-token-usage"}
        cache_creation_input_tokens: {status: handled note: "extract-token-usage"}
        cache_read_input_tokens: {status: handled note: "extract-token-usage"}
        cache_creation: {status: ignored note: "per-TTL breakdown; the top-level total already covers it"}
        iterations: {status: ignored note: "per-iteration breakdown; the top-level totals already cover it"}
        output_tokens_details: {status: ignored note: "holds thinking_tokens, which is a slice of output_tokens (measured: 1689 of 2213), not an uncounted bucket"}
        server_tool_use: {status: ignored note: "count of server-side tool calls, not a token bucket"}
        service_tier: {status: ignored note: "routing metadata"}
        inference_geo: {status: ignored note: "routing metadata"}
        speed: {status: ignored note: "routing metadata"}
        fallback_credit: {status: ignored note: "billing metadata, not a token bucket. Null in every record on disk on 2026-10-07 (rg over ~/.claude/projects, claude 2.1.292)"}
    }

    # Leading wrapper tags on user-record text. `drops` is the classification the
    # code is supposed to implement: true means SYSTEM_PREFIXES swallows it
    # because nobody typed it, false means it is kept because a human did hand it
    # over. drift.nu asks is-user-text the same question and reports any tag
    # where the two answers differ — that is how a wrapper starts being counted
    # as a human turn. `status` stays on its usual axis: whether the reader is
    # live, exempt from the dead check, or waiting to be fixed.
    user_tags: {
        command-name: {status: handled drops: true note: "slash-command wrapper"}
        command-message: {status: handled drops: true note: "slash-command wrapper"}
        local-command-caveat: {status: handled drops: true note: "slash-command wrapper"}
        local-command-stdout: {status: rare drops: true note: "slash-command wrapper; present only when a local command such as /context printed something. 0 in the newest 40 files on 2026-10-19, yet 51 records since 2026-10-12, the newest written by 2.1.303 that day"}
        local-command-stderr: {status: rare drops: true note: "slash-command wrapper; present only when the command wrote to stderr"}
        task-notification: {status: handled drops: true note: "a finished background agent reporting in its own voice, filed under type: user"}
        system-reminder: {status: rare drops: true note: "Claude Code injects it. Dropped only when it leads the text — that is a turn nobody typed. A reminder appended after the user's own words leaves those words first, so the message survives the str-starts-with check whole. Leading occurrences are genuinely rare: 6 of 4690 user records in the newest 150 sessions, and 0 in a 40-session window — most reminders are appended mid-message, not leading, so a default-window run reports this dead. Rare, not dead"}
        selected-text: {status: ignored drops: false note: "the user handing over an editor selection — real user content, kept on purpose"}
        img: {status: rare drops: false note: "the user pasting an image — real user content, kept on purpose"}
        bash-input: {status: rare drops: false note: "a `!` command the user ran; render-bash-wrapper renders it instead of dropping it"}
        bash-stdout: {status: rare drops: false note: "output of a `!` command; render-bash-wrapper renders it"}
        bash-stderr: {status: rare drops: false note: "stderr of a `!` command; render-bash-wrapper renders it"}
        fork-boilerplate: {status: todo drops: false note: "wraps a fork subagent's first message: <fork-boilerplate>...</fork-boilerplate> followed by the real directive on the next line, in the same record. Unlike system-reminder the directive never stands alone, so adding this tag to SYSTEM_PREFIXES would drop the fork's actual instruction along with the framing, not just the framing. Needs a block-strip (open tag to close tag), not a str-starts-with drop — not yet implemented"}
    }

    # `sessions` columns that are blank across a whole window without anything
    # being wrong. Everything else blank in every recent session is a reader that
    # stopped reading, so this list stays short and each entry earns its place.
    expected_blank_columns: {
        parent_session_id: {note: "null for top-level sessions; only subagent rows carry a parent"}
        plan_mode_used: {note: "false unless the session used plan mode"}
        workflow: {note: "null unless the row is a Workflow subagent; a 40-file window can hold none. Live on 2026-10-07: 48 subagent rows of the last 2 weeks carry it"}
        phase: {note: "same as workflow: only Workflow subagent rows carry a phase. Live on 2026-10-07: 48 rows of the last 2 weeks"}
        ask_user_count: {note: "0 unless the session asked the user a question; AskUserQuestion is rare enough to be absent from a 40-file window (2 calls in 150 files, 10 in 300, on 2026-09-01)"}
    }
}
